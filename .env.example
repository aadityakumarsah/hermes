# Hermes environment configuration
# Copy to .env and fill in real values.

HERMES_ENV=development
HOST=0.0.0.0
PORT=3000

# PostgreSQL 16 (install pgvector extension for embeddings)
DATABASE_URL=postgres://hermes:hermes@localhost:5432/hermes
DATABASE_MAX_CONNECTIONS=10

# Redis 7
REDIS_URL=redis://localhost:6379

# Auth
# Generate with: openssl rand -base64 48
JWT_SECRET=change-me-change-me-change-me-change-me-change-me
JWT_EXPIRES_IN=24h
API_KEY_HMAC_SECRET=change-me-change-me-change-me-change-me

# Observability
LOG_LEVEL=info
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318