{
  "name": "hermes",
  "version": "0.1.0",
  "private": true,
  "description": "Hermes / Clawbot Agent — memory-rich, full-stack AI agent",
  "type": "module",
  "packageManager": "pnpm@12.4.1",
  "engines": {
    "node": ">=20.16.0"
  },
  "scripts": {
    "build": "pnpm -r --workspace-concurrency=4 run build",
    "dev": "pnpm --filter @hermes/server dev",
    "start": "pnpm --filter @hermes/server start",
    "typecheck": "pnpm -r --workspace-concurrency=4 run typecheck",
    "test": "pnpm -r run test",
    "lint": "pnpm -r run lint",
    "db:generate": "pnpm --filter @hermes/storage db:generate",
    "db:migrate": "pnpm --filter @hermes/storage db:migrate"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.6.3",
    "tsx": "^4.19.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild"]
  }
}